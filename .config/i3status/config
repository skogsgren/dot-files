general {
        colors = true
        interval = 5
}

order += "read_file layout"
order += "battery 0"
order += "volume master"
order += "cpu_temperature 0"
order += "memory"
order += "tztime local"
order += "path_exists VPN"
order += "wireless _first_"
order += "ethernet enp3s0"

general {
        colors = true
        color_good     = "#ffffff"
        color_degraded = "#ffff55"
        color_bad      = "#ff5555"
        interval       = 5
}

battery 0 {
        format = "%status %percentage"
        format_percentage = "%.0f%s"
        format_down = "no battery"
        status_chr = "CHR"
        status_bat = "BAT"
        status_unk = "UNK"
        status_full = "FULL"
        last_full_capacity = true
        low_threshold = 15
        threshold_type = percentage
}

volume master {
        format = "VOL %volume"
        format_muted = "VOL muted"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

memory {
        format = "RAM %used/%total"
        unit = "Gi"
        decimals = 1
        memory_used_method = "memavailable"
        threshold_degraded = "10%"
        threshold_critical = "5%"
        format_degraded = "RAM LOW avail %available"
}

tztime local {
        format = "%a %d %b %H:%M"
}

read_file layout {
        path = "~/.cache/i3status-layout"
        format = "%content"
        format_bad = ""
}

wireless _first_ {
        format_up = "%essid%quality"
        format_down = ""
}

ethernet enp3s0 {
        format_up = "ETH"
        format_down = ""
}

cpu_temperature 0 {
        format = "CPU %degrees °C"
        path = "/sys/class/thermal/thermal_zone0/temp"
        max_threshold = 80
        format_above_threshold = "CPU HOT %degrees °C"
}
